# Local dev vars for the API worker (crr-criteria-api).
# Copy to `public/crr-criteria/.dev.vars` (gitignored) and fill in.
#
# ARCH-MIG-01 slice 3 — the assessment pipeline. Needed only when running the
# two-worker dev round trip:
#   npx wrangler dev -c wrangler.json -c public/crr-criteria/wrangler.json --persist-to ./.wrangler/state
# `ASSESS_INTERNAL_KEY` must be the SAME value here and in the root
# `.dev.vars` — /api/assess/evaluate 403s unless the forwarded `x-assess-internal`
# header matches it, and 404s unless `ASSESS_PIPELINE_ENABLED` is "true" (SD-11).
# In production it is set with `npx wrangler secret put ASSESS_INTERNAL_KEY
# --config public/crr-criteria/wrangler.json`.
#
# `ANTHROPIC_API_KEY` and `ADMIN_KEY` are separate secrets used by other routes
# (triage proxy, admin) — not needed for the assess round trip.

ASSESS_INTERNAL_KEY=
ASSESS_PIPELINE_ENABLED=true
