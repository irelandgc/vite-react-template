# Local dev vars for the API worker (crr-criteria-api).
# Copy to `public/crr-criteria/.dev.vars` (gitignored) and fill in.
#
# ARCH-MIG-01 slice 3 — the assessment pipeline. Needed only when running the
# two-worker dev round trip:
#   npx wrangler dev -c wrangler.json -c public/crr-criteria/wrangler.json --persist-to ./.wrangler/state
# `ASSESS_INTERNAL_KEY` must be the SAME value here and in the root
# `.dev.vars` — /api/assess/evaluate 403s unless the forwarded `x-assess-internal`
# header matches it, and 404s unless `ASSESS_PIPELINE_ENABLED` is "true" (SD-11).
# In production it is set with `npx wrangler secret put ASSESS_INTERNAL_KEY
# --config public/crr-criteria/wrangler.json`.
#
# `ANTHROPIC_API_KEY` and `ADMIN_KEY` are separate secrets used by other routes
# (triage proxy, admin) — not needed for the assess round trip.

ASSESS_INTERNAL_KEY=
ASSESS_PIPELINE_ENABLED=true

# ── SR-14 · dev/prod isolation for mutating /api/admin/* routes ───────────────
# A mutating /api/admin request is refused (403) unless it EITHER carries
# `x-admin-proxy` matching ADMIN_PROXY_KEY (the shared secret the main worker's
# admin proxy injects — proof the request arrived via the CRR_API service
# binding), OR carries a valid x-admin-key AND finds ADMIN_WRITES_ENABLED=true.
#
# ADMIN_WRITES_ENABLED — set to "true" ONLY in production (wrangler.json vars or
#   a secret). Absent here so a dev API worker refuses scripted admin writes;
#   seed a local D1/KV with `wrangler d1 execute --local` / `wrangler kv key put
#   --local` instead.
# ADMIN_PROXY_KEY — SAME value as the root .dev.vars. Set it if you want the
#   local admin tool's writes (via the local proxy) to work. Production:
#   `npx wrangler secret put ADMIN_PROXY_KEY --config public/crr-criteria/wrangler.json`.
ADMIN_PROXY_KEY=
# ADMIN_KEY=
